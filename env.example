# -----------------------------------------------------------------------------
# MAIL SERVER CONFIGURATION (Brevo SMTP)
# -----------------------------------------------------------------------------

# Copy this file to ".env" before use:
#   mv .env.example .env
#
# Replace all placeholder values below with your actual Brevo credentials.
# Do not commit real credentials to version control.

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587


# Brevo SMTP username (typically your Brevo account email)
MAIL_USERNAME=your_brevo_account_email

# Brevo SMTP key (generate from Brevo SMTP settings)
MAIL_PASSWORD=your_brevo_smtp_key

# Use "tls" for port 587, or "ssl" for port 465
MAIL_ENCRYPTION=tls

# -----------------------------------------------------------------------------
# DEFAULT SENDER IDENTITY
# -----------------------------------------------------------------------------

# Must be a sender address verified in Brevo
MAIL_FROM_ADDRESS=[no-reply@yourdomain.com](mailto:no-reply@yourdomain.com)

# Friendly sender name displayed to recipients
MAIL_FROM_NAME="Your Application"

# -----------------------------------------------------------------------------
# PRODUCTION NOTES
# -----------------------------------------------------------------------------

# After creating your .env file, restrict permissions:
# chmod 600 .env
#
# Ensure all placeholder values have been replaced before deployment.
